NODE_ENV=production
PORT=3000
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://REPLACE_WITH_MANAGED_REPLICA_SET
DB_NAME=ComunityBazar
FIREBASE_PROJECT_ID=REPLACE_WITH_REAL_FIREBASE_PROJECT
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
ALLOWED_ORIGINS=https://REPLACE_WITH_FRONTEND_DOMAIN
PUBLIC_API_URL=https://REPLACE_WITH_API_DOMAIN
MEDIA_DIRECTORY=/app/media
# Only set this to the exact number of trusted reverse proxy hops.
# TRUST_PROXY_HOPS=1
# Never set FIREBASE_AUTH_EMULATOR_HOST in production.
